{
  "name": "webaigenacademy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean:next": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/clean-next.ps1",
    "dev": "next dev --webpack",
    "dev:fresh": "npm run clean:next && next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:verify": "node scripts/verify-db.js",
    "db:list-users": "node scripts/list-users.js",
    "sync:course-notebooks": "sh scripts/sync-course-notebooks.sh",
    "build:jupyterlite": "npm run sync:course-notebooks && sh -c 'JUPYTER=\"${JUPYTER:-jupyter}\"; [ -x .venv-jupyterlite/bin/jupyter ] && JUPYTER=.venv-jupyterlite/bin/jupyter; \"$JUPYTER\" lite build --contents jupyterlite-content --output-dir public/jupyterlite' && node scripts/generate-contents-api.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "fs": "^0.0.1-security",
    "gray-matter": "^4.0.3",
    "katex": "^0.17.0",
    "lucide-react": "^1.33.0",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "resend": "^6.26.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
